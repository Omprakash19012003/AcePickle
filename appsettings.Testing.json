{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {    
    "ConnectionString": "#{ConnectionString}#"
  },
  "CorsOrigins": {
    "AllowedOrigins": [      
      "https://test-beta.becomeaskiller.com"
    ]
  },
  "AppSettings": {
    "JWTValidIssuer": "https://testing-beta-skiller-api.azurewebsites.net",
    "JWTValidAudiences":[     
      "https://testing-beta-skiller-api.azurewebsites.net",
      "https://testing-skiller-signalr.azurewebsites.net"
    ],
    "JWTSecret": "#{JwtSecret}#",
    "EnablePushNotificationForChat" : true
  }
}
