{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ConnectionString": "#{ConnectionString}#",
    "ConnectionString_Predev": "#{ConnectionString}#"
  },
  "CorsOrigins": {
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"     
    ]
  },
  "AppSettings": {
    "JWTValidIssuer": "",
    "JWTValidAudiences":[
      "https://localhost:7113",
      "https://localhost:7015"
    ],
    "JWTSecret": "#{JwtSecret}#",
    "EnablePushNotificationForChat" : true
  }
}
